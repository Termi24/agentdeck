# Proxy server
PROXY_HOST=127.0.0.1
PROXY_PORT=4317

# Web UI
NEXT_PUBLIC_PROXY_URL=http://127.0.0.1:4317

# SQLite database (relative to repo root)
DATABASE_URL=file:./data/agentdeck.db

# Workspace root for project isolation (git worktrees + sandbox)
WORKSPACE_ROOT=./data/workspaces

# Procedures library
PROCEDURES_DIR=./procedures

# Claude Agent SDK auth
# Leave ANTHROPIC_API_KEY empty to reuse the local `claude` CLI login credentials.
# ANTHROPIC_API_KEY=

# OpenTelemetry (optional, P4)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=agentdeck
